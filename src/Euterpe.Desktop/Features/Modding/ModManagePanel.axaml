<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:contracts="using:Euterpe.Contracts.Mods"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mods="using:Euterpe.Models.Mods"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Euterpe.Features.Modding"
    x:Class="Euterpe.Features.Modding.ModManagePanel"
    x:DataType="vm:ModManagePanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ModManagePanelViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <StyleInclude
            Source="avares://Euterpe.Controls/Themes/ControlStyles/Panels/ModManagePanelStyles.axaml" />
        <Style
            Selector="Border#DropOverlay">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style
            Selector="Grid.DragOver &gt; Border#DropOverlay">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!--  Main Layout Grid  -->
    <Grid
        e:DropZone.IsActive="True"
        ColumnDefinitions="380,*">

        <Interaction.Behaviors>
            <FilesDropBehavior
                Command="{Binding ImportModsCommand}" />
        </Interaction.Behaviors>

        <!--  Left Panel: Mod List Section  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource SecondaryCardColor}"
            Margin="0,0,20,10"
            Padding="0"
            Theme="{DynamicResource CardBorder}">

            <Grid
                RowDefinitions="Auto,*">

                <!--  Search and Filter Section  -->
                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="*,Auto"
                    Margin="15,15,15,10">

                    <!--  Search Box  -->
                    <TextBox
                        Grid.Column="0"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        Classes="ClearButton"
                        Margin="0,0,10,0"
                        MaxLength="30"
                        PlaceholderText="{Localize {x:Static loc:XAMLLiteral.SearchBarPlaceholder_Mod}}"
                        Text="{Binding Filter.SearchText, Mode=OneWayToSource}">
                        <TextBox.InnerLeftContent>
                            <PathIcon
                                Data="{StaticResource SemiIconSearch}"
                                Height="18" />
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <!--  Filter Dropdown  -->
                    <ComboBox
                        Grid.Column="1"
                        DisplayMemberBinding="{Binding Display.Value}"
                        ItemsSource="{Binding ModFilters, Mode=OneTime}"
                        SelectedValue="{Binding Filter.ModFilter, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Value}" />

                </Grid>

                <!--  Mod List  -->
                <u:LoadingContainer
                    Grid.Row="1"
                    IsLoading="{Binding !AllModsLoaded, Mode=OneWay}"
                    LoadingMessage="{Localize {x:Static loc:XAMLLiteral.LoadingMessage}}"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <ScrollViewer
                        AllowAutoHide="{Binding !Config.AlwaysShowScrollBar, Mode=OneWay}"
                        Margin="12,0,12,12">
                        <u:SelectionList
                            ItemsSource="{Binding Mods, Mode=OneWay}"
                            SelectedItem="{Binding SelectedMod, Mode=OneWayToSource}">

                            <u:SelectionList.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel
                                        Orientation="Vertical"
                                        VerticalAlignment="Top" />
                                </ItemsPanelTemplate>
                            </u:SelectionList.ItemsPanel>

                            <!--  Selection Indicator  -->
                            <u:SelectionList.Indicator>
                                <Border
                                    Background="Transparent"
                                    CornerRadius="4">
                                    <Border
                                        Background="{DynamicResource SemiBlue6}"
                                        CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,8"
                                        Width="4" />
                                </Border>
                            </u:SelectionList.Indicator>

                            <!--  Mod Item Template  -->
                            <u:SelectionList.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        ColumnDefinitions="*,60"
                                        Width="320">
                                        <StackPanel
                                            Height="60"
                                            Margin="8,5"
                                            Spacing="5">

                                            <!--  Mod Name  -->
                                            <TextBlock
                                                Classes.Active="{Binding $parent[u:SelectionListItem].IsSelected, Mode=OneWay}"
                                                Text="{Binding Name, Mode=OneWay}" />

                                            <!--  Mod Status Tags  -->
                                            <StackPanel
                                                Classes="ControlsHorizontal">
                                                <StackPanel.Styles>
                                                    <Style
                                                        Selector="Label.Grey">
                                                        <Setter Property="Content" Value="{Binding Version, Mode=OneWay}" />
                                                    </Style>
                                                    <Style
                                                        Selector="Label.Indigo">
                                                        <Setter Property="Content" Value="{Binding LocalVersion, Mode=OneWay}" />
                                                    </Style>
                                                </StackPanel.Styles>

                                                <Label
                                                    Classes="Ghost TagLabel"
                                                    Classes.Grey="{Binding !IsLocal, Mode=OneWay}"
                                                    Classes.Indigo="{Binding IsLocal, Mode=OneWay}" />

                                                <StackPanel
                                                    Classes="ControlsHorizontal"
                                                    IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Outdated}, Mode=OneWay}">
                                                    <PathIcon
                                                        Data="{StaticResource SemiIconArrowRight}"
                                                        Height="10" />
                                                    <Label
                                                        Classes="Ghost Green TagLabel"
                                                        Content="{Binding Version, Mode=OneWay}" />
                                                </StackPanel>

                                                <Label
                                                    Classes="Ghost TagLabel"
                                                    Classes.Orange="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Duplicated}, Mode=OneWay}"
                                                    Classes.Purple="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Newer}, Mode=OneWay}"
                                                    Classes.Red="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Incompatible}, Mode=OneWay}"
                                                    Classes.Yellow="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Modified}, Mode=OneWay}"
                                                    ToolTip.Tip="{Binding ReasonDisplay, Mode=OneWay}">
                                                    <Label.IsVisible>
                                                        <MultiBinding
                                                            Converter="{x:Static BoolConverters.And}">
                                                            <Binding
                                                                Converter="{x:Static ObjectConverters.NotEqual}"
                                                                ConverterParameter="{x:Static mods:ModState.Normal}"
                                                                Path="State" />
                                                            <Binding
                                                                Converter="{x:Static ObjectConverters.NotEqual}"
                                                                ConverterParameter="{x:Static mods:ModState.Outdated}"
                                                                Path="State" />
                                                        </MultiBinding>
                                                    </Label.IsVisible>
                                                </Label>

                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Busy Spinner  -->
                                        <u:LoadingIcon
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            IsVisible="{Binding IsProcessing, Mode=OneWay}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center" />

                                        <!--  Mod Toggle Switch  -->
                                        <ToggleSwitch
                                            Grid.Column="1"
                                            Command="{Binding $parent[UserControl].DataContext.ToggleModCommand, Mode=OneTime}"
                                            CommandParameter="{Binding ., Mode=OneWay}"
                                            HorizontalAlignment="Right"
                                            IsChecked="{Binding !IsDisabled, Mode=OneWay}"
                                            IsVisible="{Binding IsToggleVisible, Mode=OneWay}"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center" />

                                    </Grid>
                                </DataTemplate>
                            </u:SelectionList.ItemTemplate>
                        </u:SelectionList>
                    </ScrollViewer>
                </u:LoadingContainer>
            </Grid>
        </Border>

        <!--  Drag-over highlight overlay  -->
        <Border
            x:Name="DropOverlay"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource SemiBlue6}"
            BorderThickness="2"
            CornerRadius="8"
            IsHitTestVisible="False" />

        <!--  Right Panel: Mod Details Section  -->
        <Panel
            Grid.Column="1"
            Margin="0,0,10,10">

            <!--  Background Image  -->
            <Image
                Height="220"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                RenderOptions.BitmapInterpolationMode="HighQuality"
                Source="/Assets/Neko_Blur.webp"
                VerticalAlignment="Center" />

            <!--  Details Content  -->
            <ScrollViewer
                IsVisible="{Binding SelectedMod, Converter={x:Static StringConverters.IsNotNullOrEmpty}, Mode=OneWay}">
                <StackPanel
                    Margin="54,24,54,24"
                    Spacing="45">

                    <!--  Screenshots  -->
                    <ScrollViewer
                        x:Name="ScreenshotsScroller"
                        HorizontalScrollBarVisibility="Auto"
                        IsVisible="{Binding SelectedMod.HasScreenshots, Mode=OneWay}"
                        Margin="-30,0,-30,0"
                        VerticalScrollBarVisibility="Disabled">
                        <ItemsControl
                            HorizontalAlignment="{Binding SelectedMod.Screenshots.Length, Mode=OneWay, Converter={x:Static converters:FuncValueConverters.HorizontalAlignmentConverter}}"
                            ItemsSource="{Binding SelectedMod.Screenshots, Mode=OneWay}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="contracts:ModScreenshot">
                                    <e:AsyncImage
                                        Background="{Binding DominantColor, Converter={x:Static converters:FuncValueConverters.HexColorToBrushConverter}}"
                                        ClipToBounds="True"
                                        CornerRadius="8"
                                        DecodeHeight="200"
                                        Height="200"
                                        Margin="0,0,0,12"
                                        Source="{Binding FullUrl}"
                                        Stretch="Uniform" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  Main Info Section  -->
                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto">

                        <!--  Mod Title  -->
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="ModTitle"
                            Text="{Binding SelectedMod.Name, Mode=OneWay}" />

                        <!--  Action Buttons  -->
                        <StackPanel
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="ControlsHorizontal">

                            <!--  Config Button  -->
                            <StackPanel
                                IsVisible="{Binding SelectedMod.IsValidConfigFile, Mode=OneWay}"
                                Orientation="Horizontal"
                                Spacing="10">
                                <Button
                                    Command="{Binding OpenConfigFileCommand, Mode=OneTime}"
                                    Theme="{StaticResource GhostButton}"
                                    ToolTip.Tip="{Localize {x:Static loc:XAMLLiteral.ToolTip_EditModConfig}}">
                                    <PathIcon
                                        Data="{StaticResource SemiIconSetting}"
                                        Height="18" />
                                </Button>
                                <Separator
                                    Classes="Vertical" />
                            </StackPanel>

                            <!--  Mod Management Buttons  -->
                            <!--  Update  -->
                            <Button
                                Classes="Primary"
                                Command="{Binding UpdateModCommand, Mode=OneTime}"
                                CommandParameter="{Binding SelectedMod, Mode=OneWay}"
                                IsEnabled="{Binding !SelectedMod.IsProcessing, Mode=OneWay}"
                                IsVisible="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Outdated}, Mode=OneWay}">
                                <StackPanel
                                    Classes="ControlsHorizontal">
                                    <u:LoadingIcon
                                        Classes="Small"
                                        IsVisible="{Binding SelectedMod.IsProcessing, Mode=OneWay}" />
                                    <PathIcon
                                        Data="{StaticResource SemiIconRefresh}"
                                        Height="15"
                                        IsVisible="{Binding !SelectedMod.IsProcessing, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{Localize {x:Static loc:XAMLLiteral.Button_Update}}" />
                                </StackPanel>
                            </Button>

                            <!--  Install  -->
                            <Button
                                Command="{Binding InstallModCommand, Mode=OneTime}"
                                CommandParameter="{Binding SelectedMod, Mode=OneWay}"
                                IsEnabled="{Binding !SelectedMod.IsProcessing, Mode=OneWay}"
                                IsVisible="{Binding SelectedMod.IsInstallable, Mode=OneWay}">
                                <StackPanel
                                    Classes="ControlsHorizontal">
                                    <u:LoadingIcon
                                        Classes="Small"
                                        IsVisible="{Binding SelectedMod.IsProcessing, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{Localize {x:Static loc:XAMLLiteral.Button_Install}}" />
                                </StackPanel>
                            </Button>

                            <!--  Reinstall  -->
                            <Button
                                Command="{Binding ReinstallModCommand, Mode=OneTime}"
                                CommandParameter="{Binding SelectedMod, Mode=OneWay}"
                                IsEnabled="{Binding !SelectedMod.IsProcessing, Mode=OneWay}"
                                IsVisible="{Binding SelectedMod.IsReinstallable, Mode=OneWay}">
                                <StackPanel
                                    Classes="ControlsHorizontal">
                                    <u:LoadingIcon
                                        Classes="Small"
                                        IsVisible="{Binding SelectedMod.IsProcessing, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{Localize {x:Static loc:XAMLLiteral.Button_Reinstall}}" />
                                </StackPanel>
                            </Button>

                            <!--  Uninstall  -->
                            <Button
                                Classes="Danger"
                                Command="{Binding UninstallModCommand, Mode=OneTime}"
                                CommandParameter="{Binding SelectedMod, Mode=OneWay}"
                                IsEnabled="{Binding !SelectedMod.IsProcessing, Mode=OneWay}"
                                IsVisible="{Binding SelectedMod.IsLocal, Mode=OneWay}">
                                <StackPanel
                                    Classes="ControlsHorizontal">
                                    <u:LoadingIcon
                                        Classes="Small"
                                        IsVisible="{Binding SelectedMod.IsProcessing, Mode=OneWay}" />
                                    <TextBlock
                                        Text="{Localize {x:Static loc:XAMLLiteral.Button_Uninstall}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!--  Mod Status Tags  -->
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Classes="ControlsHorizontal"
                            Margin="0,8">
                            <StackPanel.Styles>
                                <Style
                                    Selector="Label.Grey">
                                    <Setter Property="Content" Value="{Binding SelectedMod.Version, StringFormat='v{0}', Mode=OneWay}" />
                                </Style>
                                <Style
                                    Selector="Label.Indigo">
                                    <Setter Property="Content" Value="{Binding SelectedMod.LocalVersion, StringFormat='v{0}', Mode=OneWay}" />
                                </Style>
                            </StackPanel.Styles>

                            <!--  Status Labels  -->
                            <Label
                                Classes="Ghost Blue TagLabel"
                                Content="{Localize {x:Static loc:XAMLLiteral.ModState_Normal}}"
                                IsVisible="{Binding SelectedMod.IsLocal, Mode=OneWay}" />

                            <!--  Version Label  -->
                            <Label
                                Classes="Ghost TagLabel"
                                Classes.Grey="{Binding !SelectedMod.IsLocal, Mode=OneWay}"
                                Classes.Indigo="{Binding SelectedMod.IsLocal, Mode=OneWay}" />

                            <!--  Update Version Indicator  -->
                            <StackPanel
                                Classes="ControlsHorizontal"
                                IsVisible="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Outdated}, Mode=OneWay}">
                                <PathIcon
                                    Data="{StaticResource SemiIconArrowRight}"
                                    Height="10" />
                                <Label
                                    Classes="Ghost Green TagLabel"
                                    Content="{Binding SelectedMod.Version, StringFormat='v{0}', Mode=OneWay}" />
                            </StackPanel>

                            <Label
                                Classes="Ghost TagLabel"
                                Classes.Green="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Outdated}, Mode=OneWay}"
                                Classes.Orange="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Duplicated}, Mode=OneWay}"
                                Classes.Purple="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Newer}, Mode=OneWay}"
                                Classes.Red="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Incompatible}, Mode=OneWay}"
                                Classes.Yellow="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Modified}, Mode=OneWay}"
                                IsVisible="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static mods:ModState.Normal}, Mode=OneWay}" />
                        </StackPanel>

                        <!--  Mod State Reason  -->
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Classes="StateReason"
                            Classes.Danger="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Incompatible}, Mode=OneWay}"
                            Classes.Warning="{Binding SelectedMod.State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static mods:ModState.Duplicated}, Mode=OneWay}"
                            IsVisible="{Binding SelectedMod.ReasonDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}, Mode=OneWay}"
                            Text="{Binding SelectedMod.ReasonDisplay, Mode=OneWay}" />

                        <!--  Description  -->
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,8,0,0"
                            Text="{Binding SelectedMod.Description, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  Details Section  -->
                    <StackPanel
                        HorizontalAlignment="Left">
                        <TextBlock
                            Classes="SectionTitle"
                            Text="{Localize {x:Static loc:XAMLLiteral.ModInfo_Details}}" />

                        <u:Descriptions
                            ItemAlignment="Left"
                            LabelPosition="Left"
                            Orientation="Vertical">

                            <!--  Author  -->
                            <u:DescriptionsItem
                                Content="{Binding SelectedMod.Author}"
                                Label="{Localize {x:Static loc:XAMLLiteral.ModInfo_Author}}" />

                            <!--  Game Version  -->
                            <u:DescriptionsItem
                                Label="{Localize {x:Static loc:XAMLLiteral.ModInfo_SupportedGameVersion}}">
                                <Label
                                    Classes="Ghost TagLabel"
                                    Content="{Binding SelectedMod.LocalizedCompatibleGameVersion}" />
                            </u:DescriptionsItem>

                            <!--  MelonLoader Version  -->
                            <u:DescriptionsItem
                                Label="{Localize {x:Static loc:XAMLLiteral.ModInfo_RequiredMelonLoaderVersion}}">
                                <Label
                                    Classes="Ghost TagLabel"
                                    Content="{Binding SelectedMod.MelonVersion}" />
                            </u:DescriptionsItem>

                            <!--  Repository  -->
                            <u:DescriptionsItem
                                IsVisible="{Binding SelectedMod.HasRepository, Mode=OneWay}"
                                Label="{Localize {x:Static loc:XAMLLiteral.ModInfo_Repository}}">
                                <HyperlinkButton
                                    Classes="WithIcon Underline"
                                    Content="{Localize {x:Static loc:XAMLLiteral.HyperlinkButton_Visit}}"
                                    NavigateUri="{Binding SelectedMod.RepoPageUrl}" />
                            </u:DescriptionsItem>
                        </u:Descriptions>
                    </StackPanel>

                    <!--  Dependencies Section  -->
                    <StackPanel
                        IsVisible="{Binding SelectedMod.HasDependency, Mode=OneWay}">
                        <TextBlock
                            Classes="SectionTitle"
                            Text="{Localize {x:Static loc:XAMLLiteral.ModInfo_Dependencies}}" />
                        <ItemsControl
                            ItemsSource="{Binding SelectedMod.DependencyNames, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Label
                                        Classes="Ghost Primary TagLabel"
                                        Content="{Binding ., Mode=OneWay}"
                                        Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Incompatible Mods Section: mods that can't be used alongside this one  -->
                    <StackPanel
                        IsVisible="{Binding SelectedMod.HasIncompatibleMods, Mode=OneWay}">
                        <TextBlock
                            Classes="SectionTitle"
                            Text="{Localize {x:Static loc:XAMLLiteral.ModInfo_IncompatibleMods}}" />
                        <ItemsControl
                            ItemsSource="{Binding SelectedMod.IncompatibleMods, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Label
                                        Classes="Ghost Grey TagLabel"
                                        Content="{Binding ., Mode=OneWay}"
                                        Margin="0,0,8,8" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Panel>
    </Grid>

</UserControl>