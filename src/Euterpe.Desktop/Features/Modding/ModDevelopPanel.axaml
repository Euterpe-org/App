<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.Features.Modding"
    x:Class="Euterpe.Features.Modding.ModDevelopPanel"
    x:DataType="vm:ModDevelopPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ModDevelopPanelViewModel />
    </Design.DataContext>

    <!--  Main scrollable container  -->
    <ScrollViewer>
        <StackPanel
            Classes="ContentListRoot"
            HorizontalAlignment="Stretch">

            <!--  Global button style for URL opening  -->
            <StackPanel.Styles>
                <Style
                    Selector="Button">
                    <Setter Property="Command" Value="{Binding OpenUrlCommand, Mode=OneTime}" />
                </Style>
            </StackPanel.Styles>

            <!--  Development Environment Section  -->
            <e:LabeledSection
                Title="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Section_DevelopmentEnvironment}}">
                <StackPanel
                    Margin="5,0,10,0"
                    Spacing="10">

                    <!--  .NET SDK Installation Card (Full Width)  -->
                    <Button
                        Classes="Transparent Card"
                        Command="{Binding InstallDotNetSdkCommand}"
                        IsEnabled="{Binding !DotNetSdkInstalled}">
                        <Button.Styles>
                            <Style
                                Selector="Button:pointerover Border.Hover">
                                <Setter Property="Background" Value="#7B2CBF" />
                                <Setter Property="RenderTransform" Value="scale(1.004)" />
                            </Style>
                        </Button.Styles>
                        <Border
                            Classes="Hover">
                            <DockPanel>
                                <StackPanel
                                    Orientation="Vertical">
                                    <TextBlock
                                        Classes="CardTitle"
                                        Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_DotNetSDK_Title}}">
                                        <TextBlock.Foreground>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Offset="0" Color="#AA7AE0" />
                                                <GradientStop Offset="1" Color="#D36BD0" />
                                            </LinearGradientBrush>
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                    <TextBlock
                                        Classes="CardDesc"
                                        Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_DotNetSDK_Description}}" />
                                </StackPanel>

                                <!--  Installation status indicator  -->
                                <StackPanel
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    Margin="30,0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Classes="CardDesc"
                                        IsVisible="{Binding !DotNetSdkInstalled, Mode=OneWay}"
                                        Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Status_NotInstalled}}"
                                        VerticalAlignment="Center" />
                                    <PathIcon
                                        Data="{StaticResource SemiIconVerify}"
                                        Foreground="{DynamicResource SemiColorSuccess}"
                                        Height="30"
                                        IsVisible="{Binding DotNetSdkInstalled, Mode=OneWay}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>

                    <!--  Second Row: Mod Template and Environment Variable Cards  -->
                    <Grid
                        ColumnDefinitions="*,10,*">

                        <!--  Mod Template NuGet Card  -->
                        <Button
                            Grid.Column="0"
                            Classes="Transparent Card"
                            Command="{Binding ToggleModTemplateInstallCommand}">
                            <Button.Styles>
                                <Style
                                    Selector="Button:pointerover Border.Hover">
                                    <Setter Property="Background" Value="#4B49AC" />
                                    <Setter Property="RenderTransform" Value="scale(1.004)" />
                                </Style>
                            </Button.Styles>
                            <Border
                                Classes="Hover">
                                <DockPanel>
                                    <StackPanel
                                        Orientation="Vertical">
                                        <TextBlock
                                            Classes="CardTitle"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_ModTemplate_Title}}">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Offset="0" Color="#7F7FD5" />
                                                    <GradientStop Offset="1" Color="#86A8E7" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock
                                            Classes="CardDesc"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_ModTemplate_Description}}" />
                                    </StackPanel>

                                    <!--  Installation status indicator  -->
                                    <StackPanel
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Margin="30,0"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Classes="CardDesc"
                                            IsVisible="{Binding !ModTemplateInstalled, Mode=OneWay}"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Status_NotInstalled}}"
                                            VerticalAlignment="Center" />
                                        <PathIcon
                                            Data="{StaticResource SemiIconVerify}"
                                            Foreground="{DynamicResource SemiColorSuccess}"
                                            Height="30"
                                            IsVisible="{Binding ModTemplateInstalled, Mode=OneWay}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Button>

                        <!--  Environment Variable Card  -->
                        <Button
                            Grid.Column="2"
                            Classes="Transparent Card"
                            Command="{Binding SetEnvVariableCommand}"
                            IsEnabled="{Binding !EnvVariableSet}">
                            <Button.Styles>
                                <Style
                                    Selector="Button:pointerover Border.Hover">
                                    <Setter Property="Background" Value="#047857" />
                                    <Setter Property="RenderTransform" Value="scale(1.004)" />
                                </Style>
                            </Button.Styles>
                            <Border
                                Classes="Hover">
                                <DockPanel>
                                    <StackPanel
                                        Orientation="Vertical">
                                        <TextBlock
                                            Classes="CardTitle"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_EnvVariable_Title}}">
                                            <TextBlock.Foreground>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                    <GradientStop Offset="0" Color="#059669" />
                                                    <GradientStop Offset="1" Color="#10B981" />
                                                </LinearGradientBrush>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                        <TextBlock
                                            Classes="CardDesc"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_EnvVariable_Description}}" />
                                    </StackPanel>

                                    <!--  Status indicator  -->
                                    <StackPanel
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Margin="30,0"
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                        <TextBlock
                                            Classes="CardDesc"
                                            IsVisible="{Binding !EnvVariableSet, Mode=OneWay}"
                                            Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Status_NotSet}}"
                                            VerticalAlignment="Center" />
                                        <PathIcon
                                            Data="{StaticResource SemiIconVerify}"
                                            Foreground="{DynamicResource SemiColorSuccess}"
                                            Height="30"
                                            IsVisible="{Binding EnvVariableSet, Mode=OneWay}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Button>
                    </Grid>
                </StackPanel>
            </e:LabeledSection>

            <!--  Mod Submission Section  -->
            <e:LabeledSection
                Title="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Section_SubmitMod}}">
                <Button
                    Classes="Transparent Card"
                    CommandParameter="https://euterpe-org.com"
                    Margin="5,0,10,0">
                    <Button.Styles>
                        <Style
                            Selector="Button:pointerover Border.Hover">
                            <Setter Property="Background" Value="#B32E29" />
                            <Setter Property="RenderTransform" Value="scale(1.004)" />
                        </Style>
                    </Button.Styles>
                    <Border
                        Classes="Hover">
                        <Grid
                            ColumnDefinitions="Auto,*"
                            HorizontalAlignment="Center">

                            <!--  Euterpe logo  -->
                            <Image
                                Grid.Column="0"
                                Height="64"
                                Margin="0,0,20,0"
                                Source="/Assets/Icon.png" />
                            <StackPanel
                                Grid.Column="1">
                                <TextBlock
                                    Classes="CardTitle"
                                    Text="Euterpe Hub">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#FF9966" />
                                            <GradientStop Offset="1" Color="#FF5E62" />
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                                <TextBlock
                                    Classes="CardDesc"
                                    Text="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Card_EuterpeHub_Description}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Button>
            </e:LabeledSection>

            <!--  Recommended IDEs Section  -->
            <e:LabeledSection
                Title="{Localize {x:Static loc:XAMLLiteral.ModDevelop_Section_RecommendedIDEs}}">

                <!--  3-column grid for IDE options  -->
                <Grid
                    ColumnDefinitions="*,10,*,10,*"
                    Margin="5,0,10,0">

                    <!--  VS Code  -->
                    <Button
                        Grid.Column="0"
                        Classes="Transparent Card"
                        CommandParameter="https://code.visualstudio.com">
                        <Button.Styles>
                            <Style
                                Selector="Button:pointerover Border.Hover">
                                <Setter Property="Background" Value="#0066B8" />
                                <Setter Property="RenderTransform" Value="scale(1.02)" />
                            </Style>
                        </Button.Styles>
                        <Border
                            Classes="Hover">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <Image
                                    Height="58"
                                    Source="/Assets/VSCode_Logo.png" />
                                <TextBlock
                                    Margin="0,0,0,15"
                                    Text="Visual Studio Code" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!--  JetBrains Rider  -->
                    <Button
                        Grid.Column="2"
                        Classes="Transparent Card"
                        CommandParameter="https://www.jetbrains.com/rider">
                        <Button.Styles>
                            <Style
                                Selector="Button:pointerover Border.Hover">
                                <Setter Property="Background" Value="#FC1886" />
                                <Setter Property="RenderTransform" Value="scale(1.02)" />
                            </Style>
                        </Button.Styles>
                        <Border
                            Classes="Hover">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <Image
                                    Height="58"
                                    Source="/Assets/Rider_Logo.png" />
                                <TextBlock
                                    Margin="0,0,0,15"
                                    Text="JetBrains Rider" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <!--  Visual Studio  -->
                    <Button
                        Grid.Column="4"
                        Classes="Transparent Card"
                        CommandParameter="https://visualstudio.microsoft.com">
                        <Button.Styles>
                            <Style
                                Selector="Button:pointerover Border.Hover">
                                <Setter Property="Background" Value="#5C2D91" />
                                <Setter Property="RenderTransform" Value="scale(1.02)" />
                            </Style>
                        </Button.Styles>
                        <Border
                            Classes="Hover">
                            <StackPanel
                                HorizontalAlignment="Center"
                                Orientation="Vertical"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <Image
                                    Height="58"
                                    Source="/Assets/VS_Logo.png" />
                                <TextBlock
                                    Margin="0,0,0,15"
                                    Text="Visual Studio" />
                            </StackPanel>
                        </Border>
                    </Button>

                </Grid>
            </e:LabeledSection>
        </StackPanel>
    </ScrollViewer>

</UserControl>