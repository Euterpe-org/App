<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.Features.Setting"
    x:Class="Euterpe.Features.Setting.AdvancedPanel"
    x:DataType="vm:AdvancedPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:AdvancedPanelViewModel />
    </Design.DataContext>

    <StackPanel
        Classes="ContentListRoot">
        <e:LabeledSection
            Description="{Localize {x:Static loc:XAMLLiteral.Setting_Description_IgnoreException}}"
            Title="{Localize {x:Static loc:XAMLLiteral.Setting_Title_IgnoreException}}">
            <ToggleSwitch
                IsChecked="{Binding Config.IgnoreException, Mode=TwoWay}" />
        </e:LabeledSection>
    </StackPanel>

</UserControl>