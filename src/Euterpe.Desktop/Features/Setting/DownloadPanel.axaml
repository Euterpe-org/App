<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.Features.Setting"
    x:Class="Euterpe.Features.Setting.DownloadPanel"
    x:DataType="vm:DownloadPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:DownloadPanelViewModel />
    </Design.DataContext>

    <StackPanel
        Classes="ContentListRoot">

        <!--  Download Beta  -->
        <e:LabeledSection
            Description="{Localize {x:Static loc:XAMLLiteral.Setting_Description_UpdateChannel}}"
            Title="{Localize {x:Static loc:XAMLLiteral.Setting_Title_UpdateChannel}}">
            <ComboBox
                DisplayMemberBinding="{Binding Display.Value}"
                ItemsSource="{Binding UpdateChannels, Mode=OneTime}"
                SelectedValue="{Binding Config.UpdateChannel, Mode=TwoWay}"
                SelectedValueBinding="{Binding Value}" />
        </e:LabeledSection>

    </StackPanel>

</UserControl>