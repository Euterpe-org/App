<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Euterpe.Features.Setting"
    x:Class="Euterpe.Features.Setting.FileManagementPanel"
    x:DataType="vm:FileManagementPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:FileManagementPanelViewModel />
    </Design.DataContext>

    <StackPanel
        Classes="ContentListRoot">

        <!--  MuseDash Folder  -->
        <e:LabeledSection
            Description="{Localize {x:Static loc:XAMLLiteral.Setting_Description_MuseDashFolder}}"
            Title="{Localize {x:Static loc:XAMLLiteral.Setting_Title_MuseDashFolder}}">
            <StackPanel
                Classes="LabeledSectionVertical">
                <TextBox
                    Classes="Desc"
                    Text="{Binding GameConfig.Folder, Mode=OneWay}" />
                <Button
                    Command="{Binding ChangeGameFolderCommand}"
                    Content="{Localize {x:Static loc:XAMLLiteral.Button_Reselect}}"
                    HorizontalAlignment="Left"
                    Theme="{DynamicResource OutlineButton}" />
            </StackPanel>
        </e:LabeledSection>

        <!--  Cache Folder  -->
        <e:LabeledSection
            Description="{Localize {x:Static loc:XAMLLiteral.Setting_Description_CacheFolder}}"
            Title="{Localize {x:Static loc:XAMLLiteral.Setting_Title_CacheFolder}}">
            <StackPanel
                Classes="LabeledSectionVertical">
                <TextBox
                    Classes="Desc"
                    Text="{Binding Config.CacheFolder, Mode=OneWay}" />
                <Button
                    Command="{Binding ChangeCacheFolderCommand}"
                    Content="{Localize {x:Static loc:XAMLLiteral.Button_Reselect}}"
                    HorizontalAlignment="Left"
                    Theme="{DynamicResource OutlineButton}" />
            </StackPanel>
        </e:LabeledSection>

    </StackPanel>

</UserControl>