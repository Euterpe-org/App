<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:constants="using:Euterpe.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:loc="https://github.com/Euterpe-org/Euterpe/Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Euterpe.Controls.Models"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Euterpe.Features.Setting"
    x:Class="Euterpe.Features.Setting.AboutPanel"
    x:DataType="vm:AboutPanelViewModel"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:AboutPanelViewModel />
    </Design.DataContext>

    <ScrollViewer>
        <DockPanel
            Margin="20">

            <!--  Header  -->
            <StackPanel
                DockPanel.Dock="Top"
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="20">

                <!--  LOGO  -->
                <Image
                    Height="120"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="/Assets/Icon.png" />

                <!--  Title & Version & Copyright  -->
                <StackPanel
                    Spacing="3"
                    VerticalAlignment="Center">
                    <TextBlock
                        Classes="H1"
                        HorizontalAlignment="Left"
                        Text="Euterpe App"
                        Theme="{StaticResource TitleTextBlock}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">
                        <Label
                            Classes="Blue"
                            Content="{x:Static constants:BuildInfo.DisplayVersion}"
                            Height="10"
                            Theme="{StaticResource TagLabel}" />
                        <TextBlock
                            Foreground="{DynamicResource SecondaryTextColor}"
                            Text="{x:Static constants:BuildInfo.Copyright}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  Others  -->
            <StackPanel
                DockPanel.Dock="Bottom"
                Margin="10,25,37,0"
                Orientation="Vertical"
                Spacing="10">

                <!--  About  -->
                <Border
                    Theme="{DynamicResource CardBorder}">
                    <StackPanel
                        Orientation="Vertical"
                        Spacing="20">
                        <TextBlock
                            Foreground="{DynamicResource SecondaryTextColor}"
                            Margin="13,3,13,0">

                            <TextBlock.Styles>
                                <Style
                                    Selector="Run">
                                    <Setter Property="BaselineAlignment" Value="Center" />
                                </Style>
                                <Style
                                    Selector="u|IconButton">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Command" Value="{Binding OpenUrlCommand, Mode=OneTime}" />
                                    <Setter Property="Theme" Value="{StaticResource BorderlessIconButton}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Style
                                        Selector="^ Image">
                                        <Setter Property="Height" Value="20" />
                                    </Style>
                                    <Style
                                        Selector="^:pointerover">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </Style>
                            </TextBlock.Styles>

                            <TextBlock.Inlines>
                                <Run
                                    Text="Euterpe is licensed under the " />
                                <InlineUIContainer>
                                    <u:IconButton
                                        CommandParameter="https://github.com/Euterpe-org/Euterpe/blob/master/LICENSE">
                                        <u:IconButton.Icon>
                                            <Image
                                                Source="/Assets/GPLv3_Logo.png" />
                                        </u:IconButton.Icon>
                                    </u:IconButton>
                                </InlineUIContainer>
                                <Run
                                    Text=" license." />
                                <Run
                                    Text="Powered by" />
                                <InlineUIContainer>
                                    <u:IconButton
                                        CommandParameter="https://dotnet.microsoft.com">
                                        <u:IconButton.Icon>
                                            <Image
                                                Source="/Assets/DotNet_Logo.png" />
                                        </u:IconButton.Icon>
                                    </u:IconButton>
                                </InlineUIContainer>
                                <Run
                                    Text="{x:Static constants:BuildInfo.DotNetVersion}" />
                                <Run
                                    Text="&amp;" />
                                <InlineUIContainer>
                                    <u:IconButton
                                        CommandParameter="https://avaloniaui.net">
                                        <u:IconButton.Icon>
                                            <Image
                                                Source="/Assets/Avalonia_Logo.png" />
                                        </u:IconButton.Icon>
                                    </u:IconButton>
                                </InlineUIContainer>
                                <Run
                                    Text="Avalonia " />
                                <Run
                                    Text="{x:Static constants:BuildInfo.AvaloniaVersion}" />
                            </TextBlock.Inlines>
                        </TextBlock>

                        <!--  Links  -->
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="15">
                            <StackPanel.Styles>
                                <Style
                                    Selector="u|IconButton">
                                    <Setter Property="Command" Value="{Binding OpenUrlCommand, Mode=OneTime}" />
                                    <Setter Property="IconPlacement" Value="Left" />
                                </Style>
                            </StackPanel.Styles>

                            <u:IconButton
                                Command="{Binding CheckUpdateCommand, Mode=OneTime}"
                                Content="{Localize {x:Static loc:XAMLLiteral.Button_CheckUpdate}}"
                                Icon="{StaticResource SemiIconRefresh}" />

                            <u:IconButton
                                CommandParameter="https://github.com/Euterpe-org/Euterpe"
                                Content="{Localize {x:Static loc:XAMLLiteral.Button_SourceCode}}"
                                Icon="{StaticResource SemiIconCode}" />

                            <u:IconButton
                                CommandParameter="https://translate.euterpe-org.com"
                                Content="{Localize {x:Static loc:XAMLLiteral.Button_HelpTranslate}}"
                                Icon="{StaticResource SemiIconLanguage}" />

                            <u:IconButton
                                CommandParameter="https://discord.gg/2rzjcga3nr"
                                Content="Discord"
                                Icon="{StaticResource SemiIconUserGroup}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Contributors  -->
                <Panel>
                    <e:ContributorSkeleton
                        IsVisible="{Binding !AllContributorsLoaded, Mode=OneWay}" />
                    <ItemsControl
                        ItemsSource="{Binding ContributorGroups, Mode=OneWay}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate
                                x:DataType="models:ContributorGroup">
                                <StackPanel
                                    Margin="0,16">
                                    <TextBlock
                                        Classes="H4"
                                        Text="{Binding GroupName, Mode=OneTime}"
                                        Theme="{StaticResource TitleTextBlock}" />
                                    <ItemsControl
                                        ItemsSource="{Binding Contributors, Mode=OneTime}">

                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel
                                                    Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="models:Contributor">
                                                <e:ContributorCard
                                                    AvatarUrl="{Binding AvatarUrl, Mode=OneTime}"
                                                    ButtonCommand="{Binding $parent[UserControl].DataContext.OpenUrlCommand, Mode=OneTime}"
                                                    ContributorDescription="{Binding Description, Mode=OneTime}"
                                                    ContributorName="{Binding Name, Mode=OneTime}"
                                                    Links="{Binding Links, Mode=OneTime}"
                                                    Margin="8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </StackPanel>
        </DockPanel>
    </ScrollViewer>

</UserControl>