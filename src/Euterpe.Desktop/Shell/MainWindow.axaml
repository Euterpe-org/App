<u:UrsaWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charting="using:Euterpe.Features.Charting"
    xmlns:constants="using:Euterpe.Shared"
    xmlns:converters="using:Euterpe.Converters"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:games="using:Euterpe.Models.Games"
    xmlns:home="using:Euterpe.Features.Home"
    xmlns:logging="using:Euterpe.Features.Logging"
    xmlns:modding="using:Euterpe.Features.Modding"
    xmlns:models="using:Euterpe.Controls.Models"
    xmlns:setting="using:Euterpe.Features.Setting"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:vm="using:Euterpe.Shell"
    x:Class="Euterpe.Shell.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Height="700"
    MinHeight="600"
    MinWidth="1100"
    Title="Euterpe"
    Width="1150"
    WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <u:UrsaWindow.RightContent>
        <StackPanel
            Orientation="Horizontal"
            Spacing="8"
            VerticalAlignment="Top">
            <ComboBox
                IsEnabled="False"
                ItemsSource="{Binding Config.Games, Mode=OneTime}"
                MinWidth="140"
                SelectedItem="{Binding SelectedGame, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate
                        x:DataType="games:GameConfig">
                        <TextBlock
                            Text="{Binding DisplayName, Mode=OneTime}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <u:ThemeToggleButton
                IsThreeState="False"
                Mode="Controller" />
        </StackPanel>
    </u:UrsaWindow.RightContent>

    <Grid
        ColumnDefinitions="Auto,*">
        <DockPanel
            Grid.Column="0"
            MinWidth="85">
            <u:NavMenu
                DockPanel.Dock="Top"
                HeaderBinding="{Binding ., Mode=OneTime}"
                IconBinding="{Binding IconResourceKey, Mode=OneTime}"
                IsHorizontalCollapsed="true"
                ItemsSource="{Binding NavItems, Mode=OneTime}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

                <u:NavMenu.Styles>
                    <Style
                        Selector="u|NavMenuItem /template/ Border">
                        <Setter Property="CornerRadius" Value="10" />
                        <Setter Property="Margin" Value="10, 3, 10, 3" />
                        <Setter Property="Padding" Value="0, -2, 0, -2" />
                    </Style>
                    <Style
                        Selector="u|NavMenuItem:pointerover /template/ Border">
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>
                    <Style
                        Selector="u|NavMenuItem:selected /template/ Border">
                        <Setter Property="CornerRadius" Value="10" />
                    </Style>
                </u:NavMenu.Styles>

                <u:NavMenu.IconTemplate>
                    <DataTemplate
                        x:DataType="x:String">
                        <u:TwoTonePathIcon
                            ActiveForeground="{DynamicResource SemiBlue5}"
                            ActiveStrokeBrush="{DynamicResource SemiBlue5}"
                            Data="{Binding ., Converter={x:Static converters:FuncValueConverters.SemiIconConverter}, Mode=OneWay}"
                            Foreground="{DynamicResource SemiGrey5}"
                            Height="20"
                            HorizontalAlignment="Center"
                            IsActive="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=u:NavMenuItem}, Path=IsHighlighted, Mode=TwoWay}"
                            StrokeBrush="{DynamicResource SemiGrey5}"
                            VerticalAlignment="Center"
                            Width="20" />
                    </DataTemplate>
                </u:NavMenu.IconTemplate>

                <u:NavMenu.Header>
                    <Border
                        u:NavMenu.CanToggle="False"
                        ClipToBounds="True"
                        CornerRadius="28"
                        Height="55"
                        HorizontalAlignment="Center"
                        Margin="0,15,0,10"
                        Width="55">
                        <e:AsyncImage
                            DecodeWidth="55"
                            Height="55"
                            PlaceholderSource="/Assets/Icon.png"
                            RenderOptions.BitmapInterpolationMode="HighQuality"
                            Source="{Binding AuthState.AvatarUrl}"
                            Stretch="UniformToFill"
                            Width="55" />
                    </Border>
                </u:NavMenu.Header>

                <u:NavMenu.HeaderTemplate>
                    <DataTemplate
                        x:DataType="models:NavItem">
                        <StackPanel
                            Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                Margin="0,0,6,0"
                                Text="{Binding DisplayName, Mode=OneTime}" />
                            <u:Badge
                                Header="{Binding Status, Mode=OneTime}"
                                HorizontalAlignment="Left"
                                IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneTime}"
                                Margin="4,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </u:NavMenu.HeaderTemplate>
            </u:NavMenu>

            <StackPanel
                DockPanel.Dock="Bottom"
                Margin="8,12,8,12"
                VerticalAlignment="Bottom">
                <TextBlock
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="{DynamicResource SemiColorText1}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,3"
                    Text="{x:Static constants:BuildInfo.AppName}" />
                <Label
                    Classes="Blue"
                    Content="{x:Static constants:BuildInfo.DisplayVersion}"
                    HorizontalAlignment="Center"
                    Theme="{StaticResource TagLabel}" />
            </StackPanel>
        </DockPanel>

        <u:OverlayDialogHost
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HostId="{x:Static vm:MainWindowViewModel.DialogHostId}"
            ZIndex="1" />

        <Panel
            Grid.Column="1"
            Margin="10,40,0,0">
            <home:HomePage
                DataContext="{Binding HomePageHost.Content}"
                IsVisible="{Binding $parent[Window].DataContext.HomePageHost.IsActive}" />
            <modding:ModdingPage
                DataContext="{Binding ModdingPageHost.Content}"
                IsVisible="{Binding $parent[Window].DataContext.ModdingPageHost.IsActive}" />
            <charting:ChartingPage
                DataContext="{Binding ChartingPageHost.Content}"
                IsVisible="{Binding $parent[Window].DataContext.ChartingPageHost.IsActive}" />
            <logging:LoggingPage
                DataContext="{Binding LoggingPageHost.Content}"
                IsVisible="{Binding $parent[Window].DataContext.LoggingPageHost.IsActive}" />
            <setting:SettingPage
                DataContext="{Binding SettingPageHost.Content}"
                IsVisible="{Binding $parent[Window].DataContext.SettingPageHost.IsActive}" />
        </Panel>
    </Grid>

</u:UrsaWindow>