<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Home Page  -->
    <x:Double
        x:Key="HomeBackgroundOpacity">
        0.65
    </x:Double>
    <DropShadowEffect
        x:Key="HomeTitleEffect"
        Color="#1A365D"
        BlurRadius="7"
        OffsetX="0"
        OffsetY="3" />

    <!--  General Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #EDF2F7
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #1A365D
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #4A5568
    </Color>

    <!--  Button Colors  -->
    <Color
        x:Key="PrimaryButtonStart">
        #3B8BFF
    </Color>
    <Color
        x:Key="PrimaryButtonEnd">
        #66B1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverStart">
        #59A6FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverEnd">
        #7EC0FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedStart">
        #2F78E6
    </Color>
    <Color
        x:Key="PrimaryButtonPressedEnd">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonStart">
        #2F78E6
    </Color>
    <Color
        x:Key="SecondaryButtonEnd">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverStart">
        #3B8BFF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverEnd">
        #59A6FF
    </Color>
    <Color
        x:Key="SecondaryButtonPressedStart">
        #286AD8
    </Color>
    <Color
        x:Key="SecondaryButtonPressedEnd">
        #2F78E6
    </Color>

    <!--  Flyout Colors  -->
    <Color
        x:Key="FlyoutBackground">
        #F8FAFB
    </Color>
    <Color
        x:Key="FlyoutBorder">
        #E1E8ED
    </Color>
    <Color
        x:Key="FlyoutItemHoverBackground">
        #E6EEF8
    </Color>
    <Color
        x:Key="FlyoutItemSelectedBackground">
        #D8E7FB
    </Color>
    <Color
        x:Key="FlyoutForeground">
        #1A365D
    </Color>
    <Color
        x:Key="FlyoutIconForeground">
        #1A365D
    </Color>

    <Color
        x:Key="SkeletonBaseColor">
        #212E3238
    </Color>
    <Color
        x:Key="SkeletonHighlightColor">
        #0D2E3238
    </Color>

</ResourceDictionary>