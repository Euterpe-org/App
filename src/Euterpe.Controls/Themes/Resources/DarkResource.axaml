<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Home Page  -->
    <x:Double
        x:Key="HomeBackgroundOpacity">
        0.665
    </x:Double>
    <DropShadowEffect
        x:Key="HomeTitleEffect"
        Color="Transparent"
        BlurRadius="0"
        OffsetX="0"
        OffsetY="0" />

    <!--  General Colors  -->
    <Color
        x:Key="SecondaryCardColor">
        #1F2024
    </Color>
    <Color
        x:Key="PrimaryTitleColor">
        #FAFAFA
    </Color>
    <Color
        x:Key="SecondaryTextColor">
        #9CA3AF
    </Color>

    <!--  Button Colors  -->
    <Color
        x:Key="PrimaryButtonStart">
        #54A9FF
    </Color>
    <Color
        x:Key="PrimaryButtonEnd">
        #7FC1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverStart">
        #7FC1FF
    </Color>
    <Color
        x:Key="PrimaryButtonHoverEnd">
        #A1D4FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedStart">
        #4096FF
    </Color>
    <Color
        x:Key="PrimaryButtonPressedEnd">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonStart">
        #4096FF
    </Color>
    <Color
        x:Key="SecondaryButtonEnd">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverStart">
        #54A9FF
    </Color>
    <Color
        x:Key="SecondaryButtonHoverEnd">
        #7FC1FF
    </Color>
    <Color
        x:Key="SecondaryButtonPressedStart">
        #2B7AD2
    </Color>
    <Color
        x:Key="SecondaryButtonPressedEnd">
        #4096FF
    </Color>

    <!--  Flyout Colors  -->
    <Color
        x:Key="FlyoutBackground">
        #1F2024
    </Color>
    <Color
        x:Key="FlyoutBorder">
        #2A2D33
    </Color>
    <Color
        x:Key="FlyoutItemHoverBackground">
        #2B2F36
    </Color>
    <Color
        x:Key="FlyoutItemSelectedBackground">
        #343A45
    </Color>
    <Color
        x:Key="FlyoutForeground">
        #FAFAFA
    </Color>
    <Color
        x:Key="FlyoutIconForeground">
        #FAFAFA
    </Color>

    <Color
        x:Key="SkeletonBaseColor">
        #1FFFFFFF
    </Color>
    <Color
        x:Key="SkeletonHighlightColor">
        #33FFFFFF
    </Color>

</ResourceDictionary>