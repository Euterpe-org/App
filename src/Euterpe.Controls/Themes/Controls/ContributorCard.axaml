<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:e="https://github.com/Euterpe-org/Euterpe"
    xmlns:models="using:Euterpe.Controls.Models">

    <Styles.Resources>

        <!--  ContributorCard's box, so the grid keeps its place when the data lands  -->
        <ControlTheme
            x:Key="ContributorSkeletonCard"
            TargetType="ContentControl">
            <Setter Property="Height" Value="140" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Width" Value="320" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Padding="36,0,0,0"
                        Theme="{DynamicResource CardBorder}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <Border
                                Classes="Skeleton"
                                CornerRadius="32"
                                Height="64"
                                Width="64" />
                            <StackPanel
                                Spacing="9"
                                VerticalAlignment="Center">
                                <Border
                                    Classes="Skeleton"
                                    Height="14"
                                    Width="104" />
                                <Border
                                    Classes="Skeleton"
                                    Height="9"
                                    Width="150" />
                                <Border
                                    Classes="Skeleton"
                                    Height="9"
                                    Width="96" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

    </Styles.Resources>

    <Design.PreviewWith>
        <e:ContributorCard />
    </Design.PreviewWith>

    <Style
        Selector="e|ContributorCard">
        <Setter Property="Width" Value="320" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Theme="{DynamicResource CardBorder}"
                    VerticalAlignment="Top">
                    <Expander
                        IsEnabled="{TemplateBinding Links, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}">
                        <Expander.Styles>
                            <Style
                                Selector="PathIcon:disabled">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                            <Style
                                Selector="Border:disabled">
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                        </Expander.Styles>
                        <Expander.Header>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">

                                <!--  Avatar  -->
                                <Border
                                    ClipToBounds="True"
                                    CornerRadius="32"
                                    Height="64"
                                    Width="64">
                                    <e:AsyncImage
                                        DecodeHeight="64"
                                        Source="{TemplateBinding AvatarUrl, Mode=OneWay}"
                                        Stretch="UniformToFill" />
                                </Border>

                                <StackPanel
                                    Margin="0,-3,0,0"
                                    Orientation="Vertical"
                                    Spacing="3"
                                    VerticalAlignment="Center">

                                    <!--  Name  -->
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryTitleColor}"
                                        Text="{TemplateBinding ContributorName, Mode=OneWay}">
                                        <TextBlock.Styles>
                                            <Style
                                                Selector="TextBlock:disabled">
                                                <Style.Setters>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTitleColor}" />
                                                </Style.Setters>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>

                                    <!--  Description  -->
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource SecondaryTextColor}"
                                        IsVisible="{TemplateBinding ContributorDescription, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}"
                                        Text="{TemplateBinding ContributorDescription, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Width="150">
                                        <TextBlock.Styles>
                                            <Style
                                                Selector="TextBlock:disabled">
                                                <Style.Setters>
                                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextColor}" />
                                                </Style.Setters>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Expander.Header>

                        <!--  Links  -->
                        <ItemsControl
                            IsVisible="{TemplateBinding Links, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}"
                            ItemsSource="{TemplateBinding Links, Mode=OneWay}">

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel
                                        HorizontalAlignment="Center"
                                        Margin="0,8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:ContributorLink">
                                    <Button
                                        Command="{Binding ButtonCommand, RelativeSource={RelativeSource AncestorType=e:ContributorCard}, Mode=OneTime}"
                                        CommandParameter="{Binding Url, Mode=OneTime}"
                                        Margin="4">
                                        <TextBlock
                                            Text="{Binding Name, Mode=OneTime}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--  Apply rounded corner design  -->
    <Style
        Selector="e|ContributorCard ContentPresenter">
        <Setter Property="CornerRadius" Value="8" />
    </Style>

</Styles>