<Project>
    <Import Project="NativeAot.props"/>

    <PropertyGroup>
        <DebuggerSupport>false</DebuggerSupport>
    </PropertyGroup>

    <Target Name="Exclude Package Pdbs" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'"/>
        </ItemGroup>
    </Target>
</Project>